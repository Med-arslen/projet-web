        <div class="qr-image-container">
            <iframe src="/finprojet/assets/qrcodes/<?= htmlspecialchars($qrFileName) ?>" 
                    class="qr-frame"
                    id="qrFrame"></iframe>
        </div>
        
        <div class="location-info">
            <h3>Position géographique</h3>
            <div class="coordinates">
                <div class="coordinate-box">
                    <strong>Latitude:</strong>
                    <span id="lat"><?= $latitude ? number_format($latitude, 6) : 'Non disponible' ?></span>
                </div>
                <div class="coordinate-box">
                    <strong>Longitude:</strong>
                    <span id="lng"><?= $longitude ? number_format($longitude, 6) : 'Non disponible' ?></span>
                </div>
            </div>
            <div id="map"></div>
        </div>
        
        <div class="user-info">
            <p><i class="fas fa-id-card"></i> <strong>ID:</strong> <?= htmlspecialchars($user['id']) ?></p>
            <p><i class="fas fa-user"></i> <strong>Nom:</strong> <?= htmlspecialchars($user['name']) ?></p>
            <p><i class="fas fa-envelope"></i> <strong>Email:</strong> <?= htmlspecialchars($user['email']) ?></p>
            <p><i class="fas fa-user-tag"></i> <strong>Rôle:</strong> <?= htmlspecialchars($user['role']) ?></p>
            <?php if (!empty($user['phone'])): ?>
                <p><i class="fas fa-phone"></i> <strong>Téléphone:</strong> <?= htmlspecialchars($user['phone']) ?></p>
            <?php endif; ?>
        </div>
        
        <div class="info-message">
            <i class="fas fa-info-circle"></i> 
            Ce QR code contient vos informations de contact et peut être scanné pour les ajouter à un carnet d'adresses
        </div>
        
        <div class="action-buttons">
            <button class="btn" onclick="downloadQRCode()">
                <i class="fas fa-download"></i> Télécharger le QR Code
            </button>
            <button class="btn" onclick="getCurrentLocation()">
                <i class="fas fa-location-arrow"></i> Obtenir ma position
            </button>
            <button class="btn" onclick="window.location.reload()">
                <i class="fas fa-sync"></i> Actualiser
            </button>
        </div>
    </div>

    <canvas id="qrCanvas" style="display: none;"></canvas>

    <script>
    var map = L.map('map');
    var marker;
    
    // Ajouter la couche OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Si des coordonnées sont disponibles, afficher le marqueur
    <?php if ($latitude && $longitude): ?>
        var lat = <?= $latitude ?>;
        var lng = <?= $longitude ?>;
        
        // Centrer la carte sur la position
        map.setView([lat, lng], 13);
        
        // Ajouter un marqueur
        marker = L.marker([lat, lng]).addTo(map)
            .bindPopup("Position de <?= htmlspecialchars($user['name']) ?>");
    <?php else: ?>
        // Position par défaut si aucune coordonnée n'est disponible
        map.setView([48.8566, 2.3522], 2); // Vue mondiale par défaut
    <?php endif; ?>

    function getCurrentLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    const latitude = position.coords.latitude;
                    const longitude = position.coords.longitude;
                    
                    // Mettre à jour l'affichage
                    document.getElementById('lat').textContent = latitude.toFixed(6);
                    document.getElementById('lng').textContent = longitude.toFixed(6);
                    
                    // Mettre à jour la carte
                    map.setView([latitude, longitude], 13);
                    
                    if (marker) {
                        marker.setLatLng([latitude, longitude]);
                    } else {
                        marker = L.marker([latitude, longitude]).addTo(map)
                            .bindPopup("Ma position actuelle");
                    }

                    // Envoyer les coordonnées au serveur
                    fetch('../controllers/update_location.php', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            user_id: <?= $userId ?>,
                            latitude: latitude,
                            longitude: longitude
                        })
                    });
                },
                function(error) {
                    alert("Erreur lors de la récupération de la position : " + error.message);
                }
            );
        } else {
            alert("La géolocalisation n'est pas supportée par ce navigateur.");
        }
    }

    function downloadQRCode() {
        const qrFrame = document.querySelector('.qr-frame');
        const canvas = document.getElementById('qrCanvas');
        const ctx = canvas.getContext('2d');

        // Créer une nouvelle image à partir du contenu de l'iframe
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = function() {
            // Définir la taille du canvas
            canvas.width = img.width;
            canvas.height = img.height;

            // Dessiner l'image sur le canvas
            ctx.drawImage(img, 0, 0);

            // Convertir le canvas en URL de données
            try {
                const dataUrl = canvas.toDataURL('image/png');
                
                // Créer un lien de téléchargement
                const link = document.createElement('a');
                link.download = 'qrcode_<?= htmlspecialchars($user['name']) ?>.png';
                link.href = dataUrl;
                
                // Déclencher le téléchargement
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } catch (error) {
                alert('Erreur lors du téléchargement du QR code. Veuillez réessayer.');
                console.error('Erreur:', error);
            }
        };

        // Charger l'image depuis l'iframe
        const iframeContent = qrFrame.contentDocument || qrFrame.contentWindow.document;
        const qrImage = iframeContent.getElementById('qrcode').querySelector('img');
        img.src = qrImage.src;
    }

    // Vérifier si le QR code est chargé correctement
    document.getElementById('qrFrame').onerror = function() {
        alert('Erreur lors de la génération du QR code. Veuillez réessayer.');
    };

    // Attendre que l'iframe soit chargée
    document.querySelector('.qr-frame').onload = function() {
        const iframe = this;
        try {
            const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
            const qrCodeDiv = iframeDoc.getElementById('qrcode');
            if (qrCodeDiv) {
                const qrImage = qrCodeDiv.querySelector('img');
                if (qrImage) {
                    qrImage.style.display = 'block';
                }
            }
        } catch (error) {
            console.error('Erreur lors du chargement du QR code:', error);
        }
    };
    </script>
</body>
</html>