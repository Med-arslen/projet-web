<?php
require_once '../config/Database.php';
require_once '../services/QRCodeService.php';

if (!isset($_GET['user_id'])) {
    die('ID utilisateur manquant');
}

// Pour MySQL
$db = new PDO('mysql:host=localhost;dbname=films', 'root', '');
$db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

// Ajouter les colonnes si elles n'existent pas déjà
try {
    $db->exec("ALTER TABLE users ADD COLUMN IF NOT EXISTS latitude DECIMAL(10,8), ADD COLUMN IF NOT EXISTS longitude DECIMAL(11,8)");
} catch (PDOException $e) {
    // Ignorer l'erreur si les colonnes existent déjà
}

$userId = (int)$_GET['user_id'];
$db = new Database();
$pdo = $db->getConnection();

$stmt = $pdo->prepare("SELECT * FROM users WHERE id = ?");
$stmt->execute([$userId]);
$user = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$user) {
    die('Utilisateur non trouvé');
}

// Générer le QR code
$qrService = new QRCodeService();
$qrData = [
    'id' => $user['id'],
    'name' => $user['name'],
    'email' => $user['email'],
    'role' => $user['role'],
    'phone' => $user['phone'] ?? ''
];
$qrFileName = $qrService->generateQRCode($userId, $qrData);

// Récupérer les coordonnées GPS de l'utilisateur
$latitude = $user['latitude'];
$longitude = $user['longitude'];
?>
<!DOCTYPE html>
